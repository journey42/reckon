{
  "navigationFallback": {
    "rewrite": "/__spa-fallback.html",
    "exclude": [
      "/assets/*",
      "*.{js,css,json,txt,map,svg,webp,png,jpg,jpeg,gif,ico,gz,woff,woff2,ttf,eot}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "routes": [
    {
      "route": "/*.html",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
